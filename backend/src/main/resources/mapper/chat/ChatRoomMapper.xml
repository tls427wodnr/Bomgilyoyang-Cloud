<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gooroomees.neulbomgil_backend.chat.internal.mapper.ChatRoomMapper">

    <resultMap id="chatRoomResultMap"
               type="com.gooroomees.neulbomgil_backend.chat.internal.entity.ChatRoom">
        <id property="roomId" column="room_id"/>
        <result property="userId" column="user_id"/>
        <result property="lastMessageAt" column="last_message_at"/>
    </resultMap>

    <resultMap id="chatRoomResponseResultMap"
               type="com.gooroomees.neulbomgil_backend.chat.internal.dto.ChatRoomResponseDto">
        <constructor>
            <arg column="room_id" javaType="java.lang.Long"/>
            <arg column="user_id" javaType="java.lang.Long"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="last_message" javaType="java.lang.String"/>
            <arg column="last_message_at" javaType="java.time.LocalDateTime"/>
            <arg column="unread" javaType="_boolean"/>
        </constructor>
    </resultMap>

    <sql id="chatRoomColumns">
        room_id,
        user_id,
        last_message_at
    </sql>

    <insert id="insert"
            parameterType="com.gooroomees.neulbomgil_backend.chat.internal.entity.ChatRoom"
            useGeneratedKeys="true"
            keyProperty="roomId"
            keyColumn="room_id">
        INSERT INTO chat_room (
            user_id,
            last_message_at
        ) VALUES (
            #{userId},
            #{lastMessageAt}
        )
    </insert>

    <select id="findByUserId" resultMap="chatRoomResultMap">
        SELECT
            <include refid="chatRoomColumns"/>
        FROM chat_room
        WHERE user_id = #{userId}
        ORDER BY room_id ASC
        LIMIT 1
    </select>

    <select id="findById" resultMap="chatRoomResultMap">
        SELECT
            <include refid="chatRoomColumns"/>
        FROM chat_room
        WHERE room_id = #{roomId}
    </select>

    <update id="updateLastMessageAt">
        UPDATE chat_room
        SET last_message_at = #{lastMessageAt}
        WHERE room_id = #{roomId}
    </update>

    <select id="findAllChatRoomResponses" resultMap="chatRoomResponseResultMap">
        SELECT
            cr.room_id,
            cr.user_id,
            NULL AS name,
            (
                SELECT c.message
                FROM chat c
                WHERE c.room_id = cr.room_id
                ORDER BY c.created_at DESC, c.chat_id DESC
                LIMIT 1
            ) AS last_message,
            cr.last_message_at,
            CASE
                WHEN EXISTS (
                    SELECT 1
                    FROM chat unread_chat
                    WHERE unread_chat.room_id = cr.room_id
                      AND unread_chat.read_at IS NULL
                      AND unread_chat.user_id = cr.user_id
                ) THEN TRUE
                ELSE FALSE
            END AS unread
        FROM chat_room cr
        ORDER BY cr.last_message_at DESC, cr.room_id DESC
    </select>

    <select id="findChatRoomResponse" resultMap="chatRoomResponseResultMap">
        SELECT
            room_id,
            user_id,
            NULL AS name,
            NULL AS last_message,
            last_message_at,
            FALSE AS unread
        FROM chat_room
        WHERE room_id = #{roomId}
    </select>

</mapper>
