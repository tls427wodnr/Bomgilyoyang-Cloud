<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gooroomees.neulbomgil_backend.community.internal.board.mapper.BoardLikeMapper">

    <resultMap id="boardLikeResultMap"
               type="com.gooroomees.neulbomgil_backend.community.internal.board.entity.BoardLike">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <association property="board"
                     javaType="com.gooroomees.neulbomgil_backend.community.internal.board.entity.Board">
            <id property="boardid" column="board_id"/>
        </association>
    </resultMap>

    <insert id="insert"
            parameterType="com.gooroomees.neulbomgil_backend.community.internal.board.entity.BoardLike"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO board_like (
            board_id,
            user_id
        ) VALUES (
            #{board.boardid},
            #{userId}
        )
    </insert>

    <select id="findByBoardIdAndUserId" resultMap="boardLikeResultMap">
        SELECT
            id,
            board_id,
            user_id
        FROM board_like
        WHERE board_id = #{boardId}
          AND user_id = #{userId}
    </select>

    <select id="existsByBoardIdAndUserId" resultType="boolean">
        SELECT CASE
            WHEN COUNT(*) &gt; 0 THEN TRUE
            ELSE FALSE
        END
        FROM board_like
        WHERE board_id = #{boardId}
          AND user_id = #{userId}
    </select>

    <delete id="deleteById">
        DELETE FROM board_like
        WHERE id = #{id}
    </delete>

    <delete id="deleteByBoardId">
        DELETE FROM board_like
        WHERE board_id = #{boardId}
    </delete>

</mapper>
