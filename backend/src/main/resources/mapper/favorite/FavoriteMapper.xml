<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gooroomees.neulbomgil_backend.favorite.internal.mapper.FavoriteMapper">

    <resultMap id="favoriteResultMap"
               type="com.gooroomees.neulbomgil_backend.favorite.internal.entity.Favorite">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="facilityId" column="facility_id"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.gooroomees.neulbomgil_backend.favorite.internal.entity.Favorite"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO favorite (
            user_id,
            facility_id
        ) VALUES (
            #{userId},
            #{facilityId}
        )
    </insert>

    <select id="findAllByUserId" resultMap="favoriteResultMap">
        SELECT
            id,
            user_id,
            facility_id
        FROM favorite
        WHERE user_id = #{userId}
        ORDER BY id DESC
    </select>

    <select id="findByUserIdAndFacilityId" resultMap="favoriteResultMap">
        SELECT
            id,
            user_id,
            facility_id
        FROM favorite
        WHERE user_id = #{userId}
          AND facility_id = #{facilityId}
    </select>

    <delete id="deleteByUserIdAndFacilityId">
        DELETE FROM favorite
        WHERE user_id = #{userId}
          AND facility_id = #{facilityId}
    </delete>

</mapper>
